# Copiar este archivo a ".env" y cambiar las contraseñas.
# .env NO se sube al repositorio (está en .gitignore).
# Usar contraseñas con letras y números (sin @ : / # ni espacios, porque
# van dentro de una URL de conexión).

POSTGRES_DB=bodegas
POSTGRES_USER=bodegas_owner
POSTGRES_PASSWORD=cambiar_propietario
API_DB_PASSWORD=cambiar_api
LECTURA_DB_PASSWORD=cambiar_lectura

# Carga masiva: 1 = volumen completo (150.000 comprobantes, ~1-3 min).
# 0.1 = carga reducida (para pruebas rápidas o planes gratuitos en la nube).
SEED_ESCALA=1
SEMILLA=2026

# Puertos en tu máquina
DB_PORT=5432
API_PORT=3000
FRONT_PORT=8080

# URL de la API vista desde el navegador y orígenes permitidos por CORS
API_URL=http://localhost:3000
CORS_ORIGIN=*
