    CEPA ||--o{ COMPOSICION : "interviene en"
    VINO ||--|{ VINO_MARIDAJE : "se recomienda con"
    MARIDAJE ||--o{ VINO_MARIDAJE : "acompaña"
    CLIENTE ||--o| DISTRIBUIDOR : "es un (subtipo)"
    CLIENTE ||--o| EXPORTADOR : "es un (subtipo)"
    EXPORTADOR ||--o{ PERMISO_EXPORTACION : "tiene"
    CLIENTE ||--o{ COMPROBANTE : "compra"
    SALA_VENTA ||--o{ COMPROBANTE : "emite"
    COMPROBANTE ||--|{ RENGLON_COMPROBANTE : "contiene"
    VINO ||--o{ RENGLON_COMPROBANTE : "se vende en"
    TRANSPORTISTA ||--o{ TRANSPORTISTA_LOCALIDAD : "cubre"
    LOCALIDAD ||--o{ TRANSPORTISTA_LOCALIDAD : "es cubierta por"
    TRANSPORTISTA ||--o{ INGRESO : "traslada"
    BODEGA ||--o{ INGRESO : "origina"
    INGRESO ||--o{ RENGLON_INGRESO : "contiene"
    VINO ||--o{ RENGLON_INGRESO : "ingresa en"
    SALA_VENTA ||--o{ TRANSFERENCIA : "solicita"
    TRANSFERENCIA ||--o{ RENGLON_TRANSFERENCIA : "contiene"
    VINO ||--o{ RENGLON_TRANSFERENCIA : "se transfiere en"
