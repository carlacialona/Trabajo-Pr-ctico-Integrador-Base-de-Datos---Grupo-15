    LOCALIDAD ||--o{ SALA_VENTA : "tiene"
    LOCALIDAD ||--o{ CLIENTE : "domicilio de"
    SALA_VENTA ||--|{ EMPLEADO : "emplea"
    FINCA ||--|{ PARCELA : "se divide en (débil)"
    CEPA ||--o{ PARCELA : "plantada en"
    PARCELA ||--o{ LOTE_UVA : "cosecha (1 por campaña)"
    LOTE_UVA ||--|{ ANALISIS_CALIDAD : "se analiza"
    BODEGA ||--o{ LOTE_UVA : "recibe"
    BODEGA ||--o{ VINO : "elabora"
